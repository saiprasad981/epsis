# =====================================================================
# EPSIS — Environment & Project Configuration Example
# Copy this file to .env and configure your Google Cloud Project ID
# =====================================================================

# Google Cloud Platform (GCP) Project ID with Earth Engine API enabled
GCP_PROJECT_ID=gen-lang-client-0301255187

# OpenStreetMap Geocoding Contact Email (used in Nominatim API User-Agent header)
NOMINATIM_CONTACT_EMAIL=your-email@example.com

# Satellite Image Acquisition Defaults
DEFAULT_AOI_BUFFER_M=1000
CLOUD_FILTER_MAX_PERCENT=20

# Application Port
PORT=8501
